# TSC target registry — cph
#
# Names the targets `scripts/measure-coherence.sh` measures.
# Loaded by `coh` (TSC CLI). Per-target manifests live alongside this file.
#
# `repo` aggregates all major surfaces and is the default target so that
# `coh --registry targets/registry.tsc` with no `--target` measures the
# whole project. The other three targets bound narrower slices for axis
# diagnosis: `hypothesis` (charter), `method` (protocols + analysis +
# scripts + notebooks), `evidence` (reports + data manifests).
#
# Generated output (`.tsc/**`) is excluded from every target's canonical
# sources; it is the measurement record, not a measurement subject.

format = "tsc-target-registry/0.1"
default_target = "repo"

[target.hypothesis]
manifest = "targets/hypothesis.tsc"

[target.method]
manifest = "targets/method.tsc"

[target.evidence]
manifest = "targets/evidence.tsc"

[target.repo]
manifest = "targets/repo.tsc"
