# Target registry for cph coherence measurement.

format = "tsc-target-registry/0.1"
default_target = "repo"

[target.hypothesis]
manifest = "targets/hypothesis.tsc"

[target.method]
manifest = "targets/method.tsc"

[target.evidence]
manifest = "targets/evidence.tsc"

[target.repo]
manifest = "targets/repo.tsc"
