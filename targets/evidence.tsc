# TSC target — evidence
#
# Surfaces that own what the repo has actually measured: field reports
# (the merged empirical state), the durable feature summary from the
# existing-data zeroth pilot, and external-data manifests (acquisition
# provenance for the OpenCap Lab Validation archive).
#
# Raw data, extracted archives, private CSVs, and participant traces
# are gitignored (see `.gitignore`). The evidence target measures what
# the repo *says* about its evidence, not the evidence files themselves.
#
# This target supports the β-axis question from CDR.md: are claims
# supported by the actual measured surfaces? Drift here looks like a
# README empirical-state line that no field report supports.

format = "tsc-target/0.1"
name = "evidence"
description = "Field reports, durable feature summaries, and external-data manifests"

sources = [
  "reports/**/*.md",
  "analysis/feature-summary-zeroth-pilot.md",
  "data/external/**/*.md",
]
