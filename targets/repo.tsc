# Aggregates the major canonical surfaces of cph.

format = "tsc-target/0.1"
name = "repo"
description = "All major canonical surfaces of cph"

sources = [
  "README.md",
  "PROJECT.md",
  "ROADMAP.md",
  "CHANGELOG.md",
  "targets/**/*.tsc",
  "docs/**/*.md",
  "protocols/**/*.md",
  "instruments/**/*.md",
  "analysis/**/*.md",
  "reports/**/*.md",
  "references/**/*.md",
  "scripts/**/*.py",
  "scripts/**/*.sh",
  "notebooks/README.md",
  "data/external/**/*.md",
]
