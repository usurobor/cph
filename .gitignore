# Raw video files
*.mp4
*.mov
*.m4v
*.avi
*.heic

# Image files
*.jpg
*.jpeg
*.png

# Private data directories
data/raw/
data/private/
opencap_exports/
participants/
consent/

# Python compile cache
__pycache__/
*.pyc

# TSC measurement output — `scripts/measure-coherence.sh` writes here.
# Reports are produced from the canonical sources, not a canonical
# source themselves; see `targets/*.tsc` exclusions.
.tsc/

# Claude Code harness scaffolding (worktrees, session metadata).
# Ephemeral container state, not project source.
.claude/

# External datasets — manifests stay in git, raw payloads do not
data/external/**/*.zip
data/external/**/*.tar.gz
data/external/**/*.trc
data/external/**/*.mot
data/external/**/*.c3d
data/external/**/*.sto
data/external/**/*.osim
data/external/**/*.csv
data/external/**/*.parquet